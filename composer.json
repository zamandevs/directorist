{
    "name": "wpwax/directorist",
    "authors": [
        {
            "name": "wpWax",
            "email": "support@wpWax.com"
        }
    ],
    "require": {
		"php": ">=7.4"
	},
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "~2.3.0",
		"phpcompatibility/phpcompatibility-wp": "~2.1.3",
        "doctrine/instantiator": "^1.5",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^7.0"
    },
    "config": {
		"allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "bamarni/composer-bin-plugin": true
        }
    },
    "scripts": {
		"setup": [
			"composer install --no-cache",
			"composer permission"
		],
		"phpcs": "vendor/bin/phpcs --standard=phpcs.xml",
		"test": "php -d xdebug.mode=off vendor/bin/phpunit",
		"test:php": "php -d xdebug.mode=off vendor/bin/phpunit",
		"format": "vendor/bin/phpcbf --standard=phpcs.xml",
		"sniffer:php8.1": "vendor/bin/phpcs -p . --standard=PHPCompatibilityWP --severity=1 --runtime-set testVersion 8.1- --extensions=php",
		"permission": [
			"chmod +x vendor/bin/phpcs",
			"chmod +x vendor/bin/phpcbf"
		]
	}
}
